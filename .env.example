# Copy to .env and adjust. Every value has a working default.

# --- Web ---------------------------------------------------------------
# Host port for the app when using docker compose.
CODR_PORT=3000
# Set to true only when serving over HTTPS (cookies get the Secure flag).
COOKIE_SECURE=false
# Set to true behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=false
# Let people create their own participant accounts from the sign-in page.
ALLOW_REGISTRATION=true
# Show the (stub) leaderboard UI for contests that enable it.
FEATURE_LEADERBOARD_UI=false
LOG_LEVEL=info

# --- First admin ----------------------------------------------------------
# Created on first start when no admin exists. Change the password afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=codr-admin
ADMIN_EMAIL=admin@codr.local
# Seed 5 sample questions and one demo contest per timing mode into an empty database.
SEED_ON_START=true

# --- Database -------------------------------------------------------------
POSTGRES_USER=codr
POSTGRES_PASSWORD=codr
POSTGRES_DB=codr
# Used by `npm run dev` outside Docker (see docker-compose.dev.yml).
DATABASE_URL=postgres://codr:codr@localhost:55432/codr

# --- Code runner (Piston) -------------------------------------------------
# Used by `npm run dev` outside Docker; compose sets http://runner:2000.
RUNNER_URL=http://localhost:2000
# Install missing language packages on boot. Needs internet once; packages
# persist in the runner-packages volume so later boots work offline.
RUNNER_AUTO_INSTALL=true
# Piston packages: gcc provides C and C++, node provides JavaScript.
# Add go and rust to enable them. Pin versions with name=version.
RUNNER_PACKAGES=python,gcc,node,java
# Programs executed in parallel.
RUNNER_CONCURRENCY=4

# --- Importer -------------------------------------------------------------
# Sent with every request the question importer makes.
IMPORT_USER_AGENT=Codr/0.1 (self-hosted contest platform; importer)
